# OANDA API Configuration
# Get your API key and account ID from https://www.oanda.com/
OANDA_API_KEY=your_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here

# OANDA API URL
# Use https://api-fxpractice.oanda.com/v3 for practice account
# Use https://api-fxtrade.oanda.com/v3 for live account
OANDA_URL=https://api-fxpractice.oanda.com/v3

# Data storage path
DATA_PATH=./data
